{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "noEmit": false
  },
  "include": [
    "electron"
  ],
  "exclude": [
    "**/*.test.ts",
    "electron/preload"
  ]
}
